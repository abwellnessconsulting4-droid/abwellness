# MongoDB connection string (required for waitlist signups)
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/abwellness?retryWrites=true&w=majority
MONGODB_URI=

# Public site URL used for metadata and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com/api-keys)
# Use onboarding@resend.dev until your domain is verified at https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=AB Wellness Consulting <onboarding@resend.dev>
WAITLIST_NOTIFY_EMAIL=hello@abwellnessconsulting.com

# Which version of the public site to serve: coming-soon | preview | live
# Default when unset: "coming-soon" for production builds, "preview" for local dev and Vercel preview deployments.
# Pages are prerendered, so changing this requires a redeploy.
SITE_MODE=

# ── EMR / client portal ────────────────────────────────────────────────
# Better Auth (sessions, MFA). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PHI field encryption (AES-256-GCM). Generate each key with: openssl rand -base64 32
# Never commit real keys; store them in Vercel as Sensitive environment variables.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Retired keys kept readable during rotation, as JSON: {"k0":"<base64>"}
ENCRYPTION_PREVIOUS_KEYS=
# Separate key for exact-match lookups (blind indexes). If unset, derived from ENCRYPTION_KEY.
BLIND_INDEX_KEY=

# ── Document storage (encrypted in the app before upload) ─────────────
# Production: a *private* Vercel Blob store connected to the project
# (vercel blob create-store <name> --access private). On Vercel it authenticates
# with OIDC; locally, paste the store's read-write token. Sign Vercel's BAA first.
# Leave both empty in development to use .data/uploads.
STORAGE_PROVIDER=
BLOB_READ_WRITE_TOKEN=

# ── Payments ───────────────────────────────────────────────────────────
# Empty = simulated test checkout (no cards). "stripe" once the adapter is built.
PAYMENT_PROCESSOR=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Integrations not connected yet ─────────────────────────────────────
# Telehealth video: empty = mock tile; "daily" needs DAILY_API_KEY and a BAA.
TELEHEALTH_PROVIDER=
DAILY_API_KEY=
# Claims clearinghouse: empty = simulated.
CLEARINGHOUSE_PROVIDER=

# ── Scheduled jobs ─────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/billing
# (autopay + payment reminders). Generate with: openssl rand -base64 32
CRON_SECRET=

# Local testing only: print emails to the console instead of sending (refused on Vercel production).
EMAIL_TRANSPORT=
