# MongoDB connection string (required for waitlist signups)
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/abwellness?retryWrites=true&w=majority
MONGODB_URI=

# Public site URL used for metadata and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com/api-keys)
# Use onboarding@resend.dev until your domain is verified at https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=AB Wellness Consulting <onboarding@resend.dev>
WAITLIST_NOTIFY_EMAIL=hello@abwellnessconsulting.com

# Which version of the public site to serve: coming-soon | preview | live
# Default when unset: "coming-soon" for production builds, "preview" for local dev and Vercel preview deployments.
# Pages are prerendered, so changing this requires a redeploy.
SITE_MODE=
